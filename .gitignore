# The case map ties public case ids (C-NN) back to private issue ids. It is
# maintained alongside the private source repo and must never be published;
# tests/check_no_leaks.py fails if a file by this name is ever found here.
casemap.json

# Local fan-out state and worktrees, per tools/fanout.py
.cadence/fanout/
.cadence/worktrees/
# ...and the same two when this repo IS the project's .cadence/ (a git
# submodule). fanout.py writes them under <project>/.cadence/, which is then
# this checkout, and the project's own .gitignore cannot reach inside a
# submodule. Without these the submodule shows as modified on every fan-out.
/fanout/
/worktrees/

# Eval output
evals/results/

__pycache__/
*.pyc
.venv/
venv/
.DS_Store
